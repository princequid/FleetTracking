# FleetTrack Pro — production reverse proxy (auto-HTTPS via Let's Encrypt).
# Domains come from the environment (see .env / DEPLOYMENT.md). Caddy obtains and
# renews TLS certificates automatically, provided:
#   1. API_DOMAIN and STORAGE_DOMAIN both resolve (DNS A record) to this server's IP.
#   2. Ports 80 and 443 are open to the internet on the server.
#
# Two separate hostnames on purpose: MinIO signs presigned photo URLs against its own
# host, so it needs a clean hostname (STORAGE_DOMAIN) with no path prefix — otherwise
# the signatures won't validate.

{
	email {$ACME_EMAIL}
}

# ── Public API (the gateway is the only backend entrypoint) ──
{$API_DOMAIN} {
	reverse_proxy api-gateway:8080
}

# ── Object storage (presigned photo upload/view URLs point here) ──
{$STORAGE_DOMAIN} {
	reverse_proxy minio:9000
}

# ── Routing (the driver app calls this directly for turn-by-turn + rerouting) ──
{$OSRM_DOMAIN} {
	reverse_proxy osrm:5000
}
