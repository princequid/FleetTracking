# ===========================================================================
# FleetTrack Pro — infrastructure secrets (TEMPLATE)
# ---------------------------------------------------------------------------
# Copy this file to `.env` (which is gitignored) and replace every value with
# strong, unique secrets before any non-local deployment. docker-compose in
# this directory automatically loads `.env` for ${VAR} interpolation.
#
# Generate strong values, e.g.:
#   JWT_SECRET / INTERNAL_SERVICE_SECRET:  openssl rand -base64 48
#   passwords:                             openssl rand -base64 24
# ===========================================================================

# ── Host port binding ───────────────────────────────────────────────────────
# CRITICAL. Controls which interface the datastore ports bind to. Leave as
# 127.0.0.1 unless you have a specific reason not to: setting 0.0.0.0 publishes
# PostgreSQL, RabbitMQ, Redis, MinIO, Eureka and the gateway directly to the
# public internet. Docker's port DNAT bypasses host iptables, so a firewall on
# the VM will NOT save you.
HOST_BIND=127.0.0.1

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=fleettrack
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=fleettrack

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=fleettrack
RABBITMQ_PASSWORD=change-me-strong-rabbit-password

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-redis-password

# ── MinIO (object storage) ──────────────────────────────────────────────────
MINIO_ROOT_USER=fleettrack
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
# Endpoint the mobile app and admin portal use to fetch presigned media URLs.
# Must be reachable from the CLIENT, so it cannot be the internal service name.
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000

# ── Application secrets ─────────────────────────────────────────────────────
# JWT signing key — MUST be at least 32 bytes (256 bits) for HS256.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Shared secret the gateway stamps on internal requests; every service verifies it.
INTERNAL_SERVICE_SECRET=change-me-strong-internal-secret

# ── Email (Gmail SMTP, used by auth-service + notification-service) ────────
# App password from a Google Account with 2-Step Verification enabled
# (myaccount.google.com/apppasswords) — NOT your regular Gmail password. Leave
# both blank to disable email sending entirely (it fails silently, logged only).
GMAIL_USERNAME=your.address@gmail.com
GMAIL_APP_PASSWORD=change-me-gmail-app-password

# ── Public URLs embedded in emails ──────────────────────────────────────────
# Both should match your deployed admin portal URL (e.g. Render) in prod —
# localhost is only correct for local dev.
FRONTEND_URL=http://localhost:5173
ADMIN_PORTAL_URL=http://localhost:5173

# ── CORS ────────────────────────────────────────────────────────────────────
# Exact-origin allowlist enforced by the gateway. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── First-run admin bootstrap ───────────────────────────────────────────────
# Creates the initial SUPER_ADMIN on boot if no admin exists. Leave both blank
# to disable. Change the password immediately after first sign-in.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ── Public domains (docker-compose.prod.yml / Caddy TLS only) ───────────────
# These have NO defaults in the prod overlay. Compose substitutes an unset
# variable as an empty string with only a warning, so omitting them makes Caddy
# start with empty site addresses, obtain no certificates, and leave the
# platform unreachable over HTTPS with a non-obvious cause.
API_DOMAIN=api.example.com
STORAGE_DOMAIN=storage.example.com
OSRM_DOMAIN=routing.example.com
ACME_EMAIL=you@example.com
