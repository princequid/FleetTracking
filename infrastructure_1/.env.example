# ===========================================================================
# FleetTrack Pro — infrastructure secrets (TEMPLATE)
# ---------------------------------------------------------------------------
# Copy this file to `.env` (which is gitignored) and replace every value with
# strong, unique secrets before any non-local deployment. docker-compose in
# this directory automatically loads `.env` for ${VAR} interpolation.
#
# Generate strong values, e.g.:
#   JWT_SECRET / INTERNAL_SERVICE_SECRET:  openssl rand -base64 48
#   passwords:                             openssl rand -base64 24
# ===========================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=fleettrack
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=fleettrack

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=fleettrack
RABBITMQ_PASSWORD=change-me-strong-rabbit-password

# ── MinIO (object storage) ──────────────────────────────────────────────────
MINIO_ROOT_USER=fleettrack
MINIO_ROOT_PASSWORD=change-me-strong-minio-password

# ── Application secrets ─────────────────────────────────────────────────────
# JWT signing key — MUST be at least 32 bytes (256 bits) for HS256.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Shared secret the gateway stamps on internal requests; every service verifies it.
INTERNAL_SERVICE_SECRET=change-me-strong-internal-secret

# ── Email (Gmail SMTP, used by auth-service + notification-service) ────────
# App password from a Google Account with 2-Step Verification enabled
# (myaccount.google.com/apppasswords) — NOT your regular Gmail password. Leave
# both blank to disable email sending entirely (it fails silently, logged only).
GMAIL_USERNAME=your.address@gmail.com
GMAIL_APP_PASSWORD=change-me-gmail-app-password

# ── Public URLs embedded in emails ──────────────────────────────────────────
# Both should match your deployed admin portal URL (e.g. Render) in prod —
# localhost is only correct for local dev.
FRONTEND_URL=http://localhost:5173
ADMIN_PORTAL_URL=http://localhost:5173
