# expo-router pulls in vaul/@radix-ui as an optional dependency chain for its web
# platform support — this project only targets ios/android (see app.json), so react-dom's
# peer version demands from that chain are irrelevant here but still trip npm's strict
# ERESOLVE check (both locally and in EAS Build, which runs `npm ci`). This is the
# standard fix for Expo Router projects that don't use the web target.
legacy-peer-deps=true
