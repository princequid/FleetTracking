{
  "expo": {
    "name": "FleetTrack Pro",
    "slug": "fleettrack-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fleettrack",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-notifications", { "color": "#0D9488" }]
    ],
    "android": {
      "package": "com.fleettrack.mobile",
      "useNextNotificationsApi": true
    },
    "ios": {
      "bundleIdentifier": "com.fleettrack.mobile",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    }
  }
}
