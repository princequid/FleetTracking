package com.fleettrack.auth.model.enums;

/**
 * The four roles in FleetTrack Pro's permission model.
 *
 *  DRIVER       - mobile app only, sees/acts on own trips only
 *  DISPATCHER   - admin portal, creates/assigns trips, no user management
 *  ADMIN        - admin portal, full operational access + user management
 *                 for DRIVER/DISPATCHER accounts, MFA required
 *  SUPER_ADMIN  - everything ADMIN can do, plus can create other ADMIN
 *                 accounts and access audit logs, MFA required
 */
public enum Role {
    DRIVER,
    DISPATCHER,
    ADMIN,
    SUPER_ADMIN
}