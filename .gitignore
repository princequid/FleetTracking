# Dependencies
node_modules/
target/

# Env & secrets
.env
.env.*
!.env.example
firebase-service-account.json
# google-services.json is intentionally NOT gitignored — unlike the Admin SDK
# service-account key above, it's a client config (API key restricted by package
# name/SHA, not a bearer credential; Google's own docs say it's safe to commit).
# EAS Build packages the project based on what git tracks, so gitignoring it would
# risk it being silently left out of a build.

# TLS certificates / private keys (generated locally, never committed)
infrastructure_1/tls/certs/
*.pem
*.key
*.crt

# Build artifacts
build/
dist/
.expo/
*.class

# OSM/OSRM data (large binaries, regeneratable via documented commands)
infrastructure_1/osrm-data/

# Database volumes
pg_data/
postgres-data/

# IDE
.idea/
*.iml

# OS
.DS_Store
Thumbs.db
